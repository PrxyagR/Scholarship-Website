# Public Supabase project settings. Use the publishable key from your project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy projects may use this name instead of the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The deployed site URL used for email confirmation and password reset links.
NEXT_PUBLIC_SITE_URL=https://maplepath-opportunities.prayagrakholia7.chatgpt.site

# Server-only owner dashboard settings. Prefer a modern sb_secret_ key.
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# Legacy projects can use this while migrating. Never expose or commit either secret.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Prefer the immutable Auth user ID after your owner account exists.
SUPABASE_ADMIN_USER_ID=your-auth-user-uuid
# Used as a fallback when SUPABASE_ADMIN_USER_ID is not set.
SUPABASE_ADMIN_EMAIL=your-email@example.com
